<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="scarlet-auth"/>
    <springProperty scope="context" name="lokiUrl"  source="loki.url"               defaultValue="http://loki:3100"/>

    <!-- ─── Console (human-readable for local dev / docker logs) ─────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId},%X{spanId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ─── Loki (structured JSON, direct push) ──────────────────────────────── -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}/loki/api/v1/push</url>
            <connectionTimeoutMs>5000</connectionTimeoutMs>
            <requestTimeoutMs>5000</requestTimeoutMs>
        </http>
        <format>
            <label>
                <!--
                    Labels become Loki stream selectors — keep cardinality LOW.
                    service/host/level are fine; do NOT label by userId, traceId, etc.
                -->
                <pattern>service=${appName},host=${HOSTNAME},level=%level</pattern>
                <readMarkers>true</readMarkers>
            </label>
            <message>
                <pattern>
                    {
                      "timestamp": "%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}",
                      "level": "%level",
                      "logger": "%logger{36}",
                      "thread": "%thread",
                      "traceId": "%X{traceId:-}",
                      "spanId":  "%X{spanId:-}",
                      "message": "%message",
                      "exception": "%ex{full}"
                    }
                </pattern>
            </message>
            <sortByTime>true</sortByTime>
        </format>
        <!-- Drop logs if Loki is unreachable — never block application threads -->
        <dropOnQueueFull>true</dropOnQueueFull>
        <sendQueueMaxBytes>41943040</sendQueueMaxBytes>  <!-- 40 MB -->
        <batchMaxItems>1000</batchMaxItems>
        <batchTimeoutMs>5000</batchTimeoutMs>
    </appender>

    <!-- Async wrapper to prevent blocking on slow Loki pushes -->
    <appender name="LOKI_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="LOKI"/>
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- ─── Root logger ──────────────────────────────────────────────────────── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI_ASYNC"/>
    </root>

    <!-- Reduce noise from framework internals -->
    <logger name="org.springframework"              level="WARN"/>
    <logger name="org.hibernate"                    level="WARN"/>
    <logger name="com.zaxxer.hikari"                level="INFO"/>
    <logger name="io.micrometer"                    level="INFO"/>
    <logger name="com.github.loki4j"                level="WARN"/>

</configuration>
